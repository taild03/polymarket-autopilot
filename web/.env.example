# Copy to web/.env.local for local development. This is a SERVER variable.
AUTOPILOT_BACKEND_URL=http://127.0.0.1:8080
# Must match the backend token if one is configured. Never use NEXT_PUBLIC_ for secrets.
# AUTOPILOT_API_TOKEN=
# Alternative to a separately running backend, local machine only:
# AUTOPILOT_ENABLE_LOCAL_CONTROL=1
# AUTOPILOT_PROJECT_ROOT=/absolute/path/to/polymarket-autopilot
# AUTOPILOT_DATA_DIR=/absolute/path/to/persistent-data
