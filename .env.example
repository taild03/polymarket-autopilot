# Shell/backend variables; never commit real tokens.
# export AUTOPILOT_DATA_DIR="$HOME/polymarket-data"
# export AUTOPILOT_API_TOKEN="generate-a-long-random-token"
# export AUTOPILOT_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Mandatory Argon entry review (default behaviour) ---
# The DEFAULT operational entry mode requires a genuine Argon assessment (via the `agy` CLI,
# model gemini-4-argon-high) of the WHOLE proposed order before any paper money is reserved
# or spent. Only an explicit Argon APPROVE opens a trade; REJECT / INSUFFICIENT_DATA /
# UNAVAILABLE (invalid JSON, timeout, quota, missing credentials) all BLOCK the entry. The
# gate never falls back to deterministic rules or another model to approve.
#
# Bounded per cycle: at most argon_max_calls_per_cycle CLI calls and argon_cycle_time_budget_sec
# of wall clock (see src/config.py). On a genuine quota/rate-limit error it performs exactly one
# retry on the configured, non-cooling alternate Google profile; if neither is usable, entries
# are blocked. Account routing uses the two logged-in profiles managed by manage_accounts.py
# (account_1 / account_2); tokens live under ~/.gemini/autopilot_accounts and are never read,
# logged or committed.
#
# IMPORTANT LIMITATION: no news/web research provider is wired in. The review context says so
# explicitly, so an honest model returns INSUFFICIENT_DATA whenever an edge would require
# outside information — i.e. with the current build, genuine APPROVEs are rare and most new
# entries are declined. This is intended conservative behaviour, not a bug.
#
# Inspect decisions: dashboard "CỔNG KIỂM DUYỆT ARGON" panel, the ARGON_ENTRY_REVIEW rows in
# ai_brain_log, the entry_review block in data/portfolio_state.json, and entry_review_* columns
# on the positions table.
#
# Deterministic/test mode (require_argon_entry_review=False) is for unit tests and offline use
# only; it is clearly labelled and never presented as a real AI inference.

# Legacy clarity-only Gemini/agy audit (separate from the entry gate above). Optional.
# export GEMINI_API_KEY=""
# export AUTOPILOT_ENABLE_AGY_SUBPROCESS=0
